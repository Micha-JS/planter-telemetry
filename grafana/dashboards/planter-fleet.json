    {
      "datasource": {
        "type": "postgres",
        "uid": "planter-timescaledb"
      },
      "description": "Forecast honesty, live: the horizon (right axis, days) ticks down at exactly one day per day of device time and resets upward when the owner refills — simulated owners refill at 5-25 % while the forecast target is 10 %, so 'the owner beat the forecast' is the correct outcome, not a bug. The battery forecast is where crossings actually land (recharge triggers at 3.0 V, below the 3.4 V target).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
