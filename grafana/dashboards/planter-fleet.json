          "rawQuery": true,
          "rawSql": "SELECT count(*) AS out_of_order FROM (SELECT measured_at, max(measured_at) OVER (PARTITION BY device_id ORDER BY received_at ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS newest_before FROM telemetry) arrivals WHERE measured_at < newest_before",
